# Copy to site.env (git-ignored) at the repo root, both on the laptop and in the NFS checkout.
TPU=my-tpu-slice            # TPU VM name (laptop side, scripts/tpu.sh)
ZONE=us-central2-b          # its zone
NUM_WORKERS=8               # hosts in the slice
NFS_ROOT=/nfs/myshare/me    # per-user NFS dir: envs, code checkout ($NFS_ROOT/llm-gcrl), logs
BUCKET=gs://my-bucket/llm-gcrl   # same-region bucket: checkpoints, converted models, profiles
